# Copy to .env (or export in the shell that runs `npm start`).

# Port the kiosk + admin are served on.
PORT=3100

# Staff PIN for the admin page. If unset, a random PIN is generated and
# printed at every boot — fine for a one-day show, annoying for longer.
ADMIN_PIN=

# Where leads and the Zoho connection are stored. Defaults to ./data.
# DATA_DIR=./data
