# Copy to .env (or export in the shell that runs `npm start`).

# Port the kiosk + admin are served on.
PORT=3100

# Staff PIN for the admin page. MUST be set, and should MATCH the one in
# Render — two servers with different PINs is a guaranteed muddle.
ADMIN_PIN=162534

# Where leads and the Zoho connection are stored. Defaults to ./data.
# DATA_DIR=./data
